{
  "rules": {
    ".read": false,
    ".write": false,
    "players": {
      ".read": true,
      ".write": "auth != null && auth.token.email != null"
    },
    "transfers": {
      ".read": true,
      ".write": "auth != null && auth.token.email != null"
    },
    "rumors": {
      ".read": true,
      ".write": "auth != null && auth.token.email != null"
    },
    "settings": {
      ".read": true,
      ".write": "auth != null && auth.token.email != null"
    },
    "cards": {
      ".read": true,
      "settings": {
        ".write": "auth != null && auth.token.email != null"
      },
      "codes": {
        ".write": "auth != null && auth.token.email != null || data.exists()"
      },
      "packs": {
        ".write": true
      },
      "inventory": {
        ".write": true
      },
      "offers": {
        ".write": true
      },
      "showcases": {
        ".write": true
      },
      "catalog": {
        ".write": "auth != null && auth.token.email != null"
      },
      "specials": {
        ".write": "auth != null && auth.token.email != null"
      },
      "packTypes": {
        ".write": "auth != null && auth.token.email != null"
      }
    },
    "fantasy": {
      ".read": true,
      "settings": {
        ".write": "auth != null && auth.token.email != null"
      },
      "rounds": {
        ".write": "auth != null && auth.token.email != null"
      },
      "scores": {
        ".write": "auth != null && auth.token.email != null"
      },
      "leaderboard": {
        ".write": "auth != null && auth.token.email != null"
      },
      "participants": {
        ".read": true,
        "$pid": {
          ".write": "(auth != null && auth.token.email != null) || data.exists()",
          ".validate": "newData.hasChildren(['displayName', 'type'])"
        }
      }
    }
  }
}

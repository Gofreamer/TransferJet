{
  "rules": {
    ".read": false,
    ".write": false,
    "players": {
      ".read": true,
      ".write": "auth != null && auth.token.email != null"
    },
    "transfers": {
      ".read": true,
      ".write": "auth != null && auth.token.email != null"
    },
    "rumors": {
      ".read": true,
      ".write": "auth != null && auth.token.email != null"
    },
    "settings": {
      ".read": true,
      ".write": "auth != null && auth.token.email != null",
      "syncedMatches": {
        "$matchId": {
          ".validate": "!data.exists() || (newData.child('at').val() === data.child('at').val() && newData.child('season').val() === data.child('season').val() && newData.child('round').val() === data.child('round').val() && newData.child('mode').val() === data.child('mode').val() && newData.child('operation').val() === data.child('operation').val())"
        }
      }
    },
    "fantasy": {
      ".read": true,
      "settings": {
        ".write": "auth != null && auth.token.email != null"
      },
      "rounds": {
        ".write": "auth != null && auth.token.email != null"
      },
      "scores": {
        ".write": "auth != null && auth.token.email != null"
      },
      "leaderboard": {
        ".write": "auth != null && auth.token.email != null"
      },
      "participants": {
        ".read": true,
        "$pid": {
          ".write": "(auth != null && auth.token.email != null) || data.exists()",
          ".validate": "newData.hasChildren(['displayName', 'type'])"
        }
      }
    }
  }
}

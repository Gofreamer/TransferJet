{
  "rules": {
    ".read": false,
    ".write": false,

    "players": {
      ".read": true,
      ".write": "auth != null && auth.token.email != null"
    },
    "transfers": {
      ".read": true,
      ".write": "auth != null && auth.token.email != null"
    },
    "rumors": {
      ".read": true,
      ".write": "auth != null && auth.token.email != null"
    },
    "settings": {
      ".read": true,
      ".write": "auth != null && auth.token.email != null"
    },
    "fantasy": {
      ".read": true,
      "settings": {
        ".write": "auth != null && auth.token.email != null"
      },
      "rounds": {
        ".write": "auth != null && auth.token.email != null"
      },
      "scores": {
        ".write": "auth != null && auth.token.email != null"
      },
      "leaderboard": {
        ".write": "auth != null && auth.token.email != null"
      },
      "participants": {
        ".read": true,
        ".write": true
      }
    }
  }
}
